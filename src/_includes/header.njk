<header class="header {{ header_class }}">
  <div class="container ">
    <div class="header__inner">
      <nav class="nav" aria-label="Main navigation">
        <ul class="nav__nav-list">
          <li class="nav__item">
            <a href="/" class="nav__nav-link">Home</a>
          </li>
          <li class="nav__item">
            <a href="#" class="nav__nav-link">
              <span class="hamburger" aria-label="Toggle menu" aria-expanded="false">
                <span class="hamburger-line"></span>
