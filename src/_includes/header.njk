          </li>
          <li class="nav__item">
            <a href="#" class="nav__nav-link">Service</a>
          </li>
          <li class="nav__item">
            <a href="#" class="nav__nav-link">Over ons</a>
          </li>
        </ul>
      </nav>
      <div class="header__logo">
        <a href="/" class="logo">
          <img src="/assets/kiener-logo-dark.svg" alt="Logo" class="logo__image logo__image--dark"/>
          <img src="/assets/kiener-logo-white.svg" alt="Logo" class="logo__image logo__image--light"/>
        </a>
      </div>
      <div class="header__actions">
        <div class="header__search search search--md">
          <input type="search" class="search__input" placeholder="Search..." aria-label="Search"/>
