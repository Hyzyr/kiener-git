<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="{{ description | default('Modern SCSS Template - Professional Component Library') }}"/>
    <title>{{ title }}</title>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="./assets/favicon.svg"/>
    <link
    rel="icon" type="image/png" href="./assets/favicon.png"/> <!-- Compiled CSS -->
    <link
    rel="stylesheet" href="./css/main.css"/>
    <link
    rel="stylesheet" href="./css/splide-core.min.css"/>
    <!-- Splide.js CSS -->
    {% if extra_css %}
      <style>
        {{extra_css | safe}}</style>
    {% endif %}
  </head>
  <body>
    {% include "header.njk" %}
    {{ content | safe }}
    {% include "footer.njk" %}
    {% include "svg-sprite.njk" %}
    <!-- Scripts -->
    <script src="./js/splide.min.js"></script>
    <script src="./js/header-nav.js"></script>
    <script src="./js/toast.js"></script>
    <script src="./js/toast-demo.js"></script>
    <script src="./js/main.js"></script>
  </body>
</html>