{
  "name": "scss-template",
  "version": "1.0.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "npm-run-all --parallel dev:*",

    "// --- DEVELOPMENT (WATCH) ---": "",
    "dev:scss": "sass src/scss:dist/css --watch --style=expanded",
    "dev:eleventy": "eleventy --serve",

    "// --- BUILD: READABLE (For Client) ---": "",
    "build": "npm-run-all clean build:scss:dev build:js:dev build:html:eleventy build:html:format",
    "build:scss:dev": "sass src/scss/main.scss dist/css/main.css --no-source-map --style=expanded",
    "build:js:dev": "node -e \"const fs = require('fs'); if (!fs.existsSync('dist/js')) fs.mkdirSync('dist/js', {recursive: true}); fs.copyFileSync('src/js/main.js', 'dist/js/main.js')\"",
    "build:html:format": "prettier --write \"dist/**/*.html\"",

    "// --- BUILD: PROD (Minified) ---": "",
    "build:prod": "npm-run-all clean build:scss:prod build:js:prod build:html:eleventy build:html:minify",
    "build:scss:prod": "sass src/scss/main.scss dist/css/main.css --no-source-map --style=compressed",
    "build:js:prod": "terser src/js/main.js -o dist/js/main.js --compress --mangle",
    "build:html:minify": "html-minifier-terser --collapse-whitespace --remove-comments --input-dir dist --output-dir dist --file-ext html",

    "// --- SHARED TASKS ---": "",
    "build:html:eleventy": "eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.0",
    "sass": "^1.70.0",
    "terser": "^5.27.0"
  }
}
